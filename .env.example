# Copy to .env and fill in from Supabase Dashboard → Settings → API
# The anon (publishable) key is safe to embed in a Vite client build; never put service_role here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
